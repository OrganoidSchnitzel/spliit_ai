# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Optional shared secret. When set, every /api request must send it as
# `X-Api-Token: <token>` or `Authorization: Bearer <token>`. /api/health stays
# public so Docker's HEALTHCHECK keeps working. Leave empty to disable.
# This service has write access to your Spliit database — set a token if the
# port is reachable by anything you do not control.
API_TOKEN=

# error | warn | info | debug. `debug` logs every SQL statement.
LOG_LEVEL=info

# Where the SQLite database and persisted settings live. Defaults to ./data.
# DATA_DIR=/app/data

# ─── PostgreSQL (Spliit's database) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spliit
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=false
# Only set this to false for a self-signed certificate you trust.
# DB_SSL_REJECT_UNAUTHORIZED=true

# ─── Ollama (local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000

# How long Ollama keeps the model in memory. Ollama's own default is 5m, which
# is shorter than the default 15m schedule — meaning the model is evicted and
# re-read from disk before every single batch. On a CPU-only box that is the
# single largest avoidable cost.
OLLAMA_KEEP_ALIVE=30m

# 0 makes categorization deterministic and repeatable.
OLLAMA_TEMPERATURE=0
# Caps runaway generations that would otherwise only stop at the timeout.
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=2048
# Retries for transient failures (connection reset, 5xx, timeout).
OLLAMA_MAX_RETRIES=2
# Constrain decoding to the response schema. Set false for Ollama below 0.5.
OLLAMA_STRUCTURED_OUTPUT=true

# ─── Categorization ───────────────────────────────────────────────────────────
# Minimum confidence (0–1) required to auto-apply a category.
# A decimal comma (0,6) is accepted; an unparseable value stops startup rather
# than silently becoming 0.
CONFIDENCE_THRESHOLD=0.6

# Suggest and log, but never write to the Spliit database. Useful for a first run.
DRY_RUN=false

# Try deterministic keyword matching before calling the LLM.
WORDLISTS_ENABLED=true

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/15 * * * *

# ─── Processing ───────────────────────────────────────────────────────────────
# Maximum expenses processed per run.
BATCH_SIZE=10

# Escalating wait (hours) before re-attempting an expense that fell below the
# confidence threshold. After the last step the expense is parked and only
# retried when you ask for it. Without this, a stuck expense is re-sent to the
# LLM on every run forever and starves everything older than it.
RETRY_BACKOFF_HOURS=1,6,24

# ─── History ──────────────────────────────────────────────────────────────────
# Processing history older than this is pruned. The log is otherwise append-only.
HISTORY_RETENTION_DAYS=90
