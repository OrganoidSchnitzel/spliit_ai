{
  "name": "spliit-ai",
  "version": "1.1.1",
  "description": "Automatic expense categorization for Spliit using local LLMs via Ollama",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^12.8.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.1",
    "node-cron": "^4.6.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "clearMocks": true
  }
}
